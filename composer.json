{
  "name": "magepsycho/magento2-opentelemetry",
  "description": "OpenTelemetry integration package for Magento 2 applications with complete observability stack",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "magento",
    "magento2",
    "opentelemetry",
    "otel",
    "observability",
    "tracing",
    "apm"
  ],
  "homepage": "https://github.com/MagePsycho/magento2-opentelemetry",
  "authors": [
    {
      "name": "Raj KB",
      "email": "rajkb@magepsycho.com"
    }
  ],
  "support": {
    "issues": "https://github.com/MagePsycho/magento2-opentelemetry/issues",
    "source": "https://github.com/MagePsycho/magento2-opentelemetry"
  },
  "require": {
    "php": "^8.1",
    "magento/framework": "*",
    "open-telemetry/api": "^1.2",
    "open-telemetry/exporter-otlp": "^1.2",
    "open-telemetry/sdk": "^1.2",
    "open-telemetry/sem-conv": "^1.30"
  },
  "autoload": {
    "psr-4": {
      "MagePsycho\\OpenTelemetry\\": "src/"
    },
    "files": [
      "_register.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
